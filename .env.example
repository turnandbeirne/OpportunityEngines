# Copy this file to .env and fill in your Supabase project's values
# (Supabase dashboard -> Project Settings -> API). VITE_-prefixed vars
# are safe to ship to the browser; the anon key is meant to be public —
# RLS is what actually protects the data, not keeping this secret.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server-side only — used by supabase/seed.mjs and the invite-member
# edge function. NEVER prefix this with VITE_, never commit it, never
# put it anywhere that ships to a browser.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
